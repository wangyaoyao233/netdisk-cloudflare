{
  "name": "transcoder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "start:dev": "node --env-file=.dev.vars --enable-source-maps dist/index.js",
    "start:remote": "node --env-file=.env.remote.local --enable-source-maps dist/index.js",
    "dev": "npm run build && npm run start:dev",
    "dev:remote": "npm run build && npm run start:remote"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  }
}
